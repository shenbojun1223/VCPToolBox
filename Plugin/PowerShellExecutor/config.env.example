# ServerPowerShellExecutor Plugin Configuration
# Version: 1.2.1

# --- 返回模式 ---
# 定义命令输出的默认返回行为。
# - "delta": 仅返回最近执行的命令输出。（默认，推荐）
# - "full": 返回完整的终端缓冲区内容。
POWERSHELL_RETURN_MODE=delta

# --- 完全禁止的指令 ---
# 列出完全禁止的命令身份，使用英文逗号分隔；不是全文关键词过滤。
# v1.2.0 使用 PowerShell 原生 AST，只解析、不执行待检文本。
# 数据字符串、注释和路径参数不匹配；执行目标的完整路径和模块限定名仍检查。
# 原始命令名和当前无配置 Shell 的别名目标同时检查，禁止项优先且验证码不可覆盖。
# 如配置 format，则同时保护 Format-Volume；Format-Table/List 等显示命令不误报。
# 本次升级不改变以下示例列表，也不会修改已部署的 config.env。
FORBIDDEN_COMMANDS=rm,del,rmdir

# --- 需要管理员授权的指令 ---
# 列出需要验证码 (tool_password) 的命令身份，使用英文逗号分隔。
# auth-required 和 review-required 均可凭正确验证码授权；这不是 Windows 提权开关。
# 文件输出重定向分别按 Set-Content/Add-Content 的配置处理；流合并不算文件写入。
# 动态调用、外部 PS 脚本、解析失败等返回 review-required，未提供正确验证码时拒绝。
# 检查故障也可凭正确验证码放行；授权者须独立审查命令。已识别的 forbidden 不可授权。
AUTH_REQUIRED_COMMANDS=net,shutdown,restart,Set-Item,Set-Content,Add-Content,Clear-Content

# --- 诊断模式 ---
# 当命令执行失败且无输出时，是否在错误返回中附带诊断信息（Shell路径、临时脚本路径等）。
# 默认开启。关闭可设为 false。
VERBOSE_ERROR=true