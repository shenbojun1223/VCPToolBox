# VCPChat / VCPMobile central sync hub
# Copy this file to config.env before enabling the service.

# Required. Use one strong random token on the server and every client.
MobileSyncToken=your_super_secret_token_here

# Mobile Sync wire protocol 1.1 WebSocket port. VCPMobile defaults to 5975.
MobileSyncPort=5975

# Optional AppData-compatible central store. Relative paths resolve from
# VCPToolBox root. Empty means Plugin/VCPChatSyncHub/data/AppData.
SyncHubAppDataPath=
